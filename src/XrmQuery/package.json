{
  "name": "@delegateas/xrmquery",
  "version": "7.0.0-preview.1",
  "description": "Type-safe Dataverse Web API query library. The XrmQuery runtime, modernized as an npm package — pairs with typings generated by XrmDefinitelyTyped.",
  "keywords": [
    "dataverse",
    "dynamics-365",
    "power-apps",
    "web-api",
    "odata",
    "xrm",
    "xrmquery",
    "xrmdefinitelytyped"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/context-and-oss/XrmDefinitelyTyped.git",
    "directory": "src/XrmQuery"
  },
  "homepage": "https://github.com/context-and-oss/XrmDefinitelyTyped/tree/main/src/XrmQuery#readme",
  "bugs": {
    "url": "https://github.com/context-and-oss/XrmDefinitelyTyped/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:xdt": "tsc --noEmit -p tests/xdt-compat/tsconfig.json",
    "typecheck:generated": "tsc --noEmit -p tests/generated-compat/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
